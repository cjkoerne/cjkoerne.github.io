body{
    background-color: rgb(182, 216, 246);
}
header{
    text-align: center;
    font-size: 49px;
    font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
    width: auto;
    height: auto;
    background-color: rgb(86, 106, 71);
    color: white;

    border-radius: 15px;
}

header h2{
    width: auto;
    height: auto;
    background-color: rgba(155, 155, 227, 0.92);
    border-radius: 15px;
}
.topic-description{
    font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
    width: auto;
    height: auto;
    background-color: rgb(104, 174, 249);
    border-radius: 15px;

}
.topic-description header{
    text-align: center;
}

h2{
    text-align: center;
    font-size: 58px;
    margin-bottom: 10px;
}

h3{
    text-align: center;
    font-size: 46px;
    margin-bottom: 10px;
}

.app-description{
    font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
    width: auto;
    height: auto;
    background-color: rgb(144, 239, 226);
    border-radius: 15px;
}

.boxes{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    flex-wrap: wrap;
}

.info-cards{
    text-decoration: none;
    display: block;
}

.info-inside{
    text-decoration: none;
    text-align: center;
    margin: auto;
    
    color: white;
    padding: 10px;
    font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
    width: 250px;
    height: auto;
    
    background-color: rgb(135, 135, 233);
    border-radius: 12px;
    

}


.info-inside img{
    height: 100px;
    width: auto;
    display: block;
    margin: 0 auto;
    text-align: center;
}

.Infopage{
    width: auto;
    height: auto;
    text-align: center;
    
    font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
    background-color: rgb(171, 171, 234);
    border-radius: 12px;

}

.contactUs{
    text-align: center;
    width: auto;
    height: auto;
    padding: 10px;
    background-color: rgb(168, 184, 230);
    border-radius: 12px;


}

.footer p{
    text-align: center;
    background-color: rgb(37, 85, 151);
    color: white;
    font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
    border-radius: 12px;

}


@media (max-width: 800px) {
    .info-inside {
        width: 45%;
    }
}


@media (max-width: 500px) {
    .info-inside {
        width: 100%;
    }
}


